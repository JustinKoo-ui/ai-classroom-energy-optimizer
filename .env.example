# Application
APP_NAME=AI Classroom Energy Optimizer
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json
TIMEZONE=Asia/Kuala_Lumpur

# Browser access
CORS_ALLOWED_ORIGINS=http://localhost:5173
WS_HEARTBEAT_SECONDS=20
WS_CLIENT_TIMEOUT_SECONDS=60

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://aceo:change-me@localhost:5432/aceo
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Authentication (use a secret manager outside development)
AUTH_ENABLED=true
OIDC_ISSUER_URL=https://identity.example.edu
OIDC_AUDIENCE=aceo-api
OIDC_JWKS_URL=https://identity.example.edu/.well-known/jwks.json
JWT_ALGORITHM=RS256

# MQTT broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=aceo-backend-ingestion
MQTT_USERNAME=aceo-backend-ingestion
MQTT_PASSWORD=replace-with-local-ingestion-password
MQTT_DISPATCHER_CLIENT_ID=aceo-backend-dispatcher
MQTT_DISPATCHER_PRODUCER_ID=command-dispatcher-local
MQTT_DISPATCHER_USERNAME=aceo-backend-dispatcher
MQTT_DISPATCHER_PASSWORD=replace-with-local-dispatcher-password
MQTT_TOPIC_ROOT=aceo/v1
# Local Compose broker is plaintext and loopback-control is localhost-only.
MQTT_TLS_ENABLED=false
LOCAL_HARDWARE_CONTROL_ENABLED=false
# Optional Worker-to-backend bridge; keep the shared token out of frontend variables.
CLASSROOM_API_PROXY_ENABLED=false
CLASSROOM_API_PROXY_TOKEN=
CLASSROOM_API_PROXY_CLASSROOM_ID=26e97d46-7a34-4439-922a-83684bda557d
# Additional opt-in for ON/OFF and Auto/Manual via verified Cloudflare operators.
CLASSROOM_REMOTE_CONTROL_ENABLED=false
CLASSROOM_REMOTE_CONTROL_ALLOWED_EMAILS=
MQTT_CA_CERT_PATH=/run/secrets/mqtt-ca.crt
MQTT_CLIENT_CERT_PATH=/run/secrets/mqtt-client.crt
MQTT_CLIENT_KEY_PATH=/run/secrets/mqtt-client.key
MQTT_KEEPALIVE_SECONDS=30
MQTT_COMMAND_ACK_TIMEOUT_SECONDS=10
MQTT_COMMAND_MAX_RETRIES=3

# Computer vision
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=justin-koo
ROBOFLOW_WORKFLOW_ID=custom-workflow
VIDEO_SOURCE=rtsp://admin:replace-with-camera-password@192.168.1.50:554/stream1
CAMERA_SOURCE=rtsp://admin:replace-with-camera-password@192.168.1.50:554/stream1
# Optional live preview: put these settings in backend/.env, never NEXT_PUBLIC_*.
# The preview keeps only the latest JPEG in memory and stops after idle viewers.
CAMERA_PREVIEW_ENABLED=false
SITE_ID=c7ef6d75-7c12-461a-bb49-73f917c3357d
CLASSROOM_ID=26e97d46-7a34-4439-922a-83684bda557d
CAMERA_ID=camera-01
MAX_FPS=10
LOG_LEVEL=INFO
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_ROOT=aceo/v1
MQTT_CLIENT_ID=aceo-cv-worker
MQTT_PRODUCER_ID=cv-worker-local
MQTT_USERNAME=aceo-cv-worker
MQTT_PASSWORD=replace-with-local-cv-password
MQTT_TLS_ENABLED=false
MQTT_PUBLISH_OCCUPANCY=true
CV_TARGET_FPS=5
CV_CONFIDENCE_THRESHOLD=0.50
CV_OBSERVATION_STALE_SECONDS=10
CV_DIAGNOSTIC_FRAME_RETENTION_ENABLED=false

# Leave-within-60-seconds prediction
PREDICTION_MODEL_PATH=ml/artifacts/leave_within_60s.joblib
PREDICTION_MODEL_VERSION=untrained-v0
PREDICTION_FEATURE_SET_VERSION=v1
PREDICTION_INTERVAL_SECONDS=5
PREDICTION_TTL_SECONDS=15
PREDICTION_RECOMMENDATION_THRESHOLD=0.80

# Deterministic policy defaults
POLICY_VERSION=1.0.0
OCCUPIED_TARGET_TEMPERATURE_C=26.0
TEMPERATURE_DEADBAND_C=0.5
TARGET_ILLUMINANCE_LUX=300
ILLUMINANCE_HYSTERESIS_LUX=30
VACANCY_GRACE_SECONDS=300
LIGHTING_VACANCY_GRACE_SECONDS=120
ENVIRONMENT_READING_STALE_SECONDS=30
POWER_READING_STALE_SECONDS=30
COMMAND_COOLDOWN_SECONDS=10
AC_MIN_ON_SECONDS=180
AC_MIN_OFF_SECONDS=180
MANUAL_OVERRIDE_MAX_SECONDS=28800
SCHEDULE_MAX_LATENESS_SECONDS=60

# Energy analytics
ENERGY_CURRENCY=MYR
ENERGY_TARIFF_PER_KWH=0.00
ENERGY_BASELINE_METHOD=matched_occupied_periods_v1
ENERGY_AGGREGATION_INTERVAL_SECONDS=60

# Read-only prototype runtime/estimated-energy model (never meter readings)
# Restart backend after changing assumptions; saved runtime observations stay intact.
ANALYTICS_STALE_AFTER_SECONDS=15
ANALYTICS_LIGHT_POWER_W=10
ANALYTICS_FAN_POWER_W=60
ANALYTICS_AC_POWER_W=1000

# Optional analyst. Leave unset for deterministic analytics only.
# OpenAI or another HTTPS provider supporting strict JSON-schema Chat Completions.
ANALYST_PROVIDER=openai_compatible
ANALYST_API_URL=https://api.openai.com/v1/chat/completions
ANALYST_API_KEY=
ANALYST_MODEL=
# Separate random local report token, entered in the dashboard (NOT the provider key).
ANALYST_ACCESS_TOKEN=
ANALYST_TIMEOUT_SECONDS=20
ANALYST_MAX_RETRIES=1
ANALYST_REQUESTS_PER_MINUTE=3
ANALYST_CACHE_TTL_SECONDS=300

# Development only
SEED_DEMO_DATA=false

# React dashboard
# Keep mock service for panels without live contracts; environment cards poll live telemetry.
NEXT_PUBLIC_USE_MOCK_DATA=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CLASSROOM_ID=26e97d46-7a34-4439-922a-83684bda557d
NEXT_PUBLIC_DASHBOARD_POLL_INTERVAL_MS=5000
# Occupancy-only opt-in; other dashboard panels remain demo-driven.
NEXT_PUBLIC_USE_LIVE_OCCUPANCY=false
NEXT_PUBLIC_ENABLE_HARDWARE_CONTROLS=false
# Production uses frontend/.env.production.local, an empty API base and exact HTTPS origin.
NEXT_PUBLIC_ENABLE_REMOTE_HARDWARE_CONTROLS=false
NEXT_PUBLIC_HARDWARE_CONTROL_ORIGIN=
