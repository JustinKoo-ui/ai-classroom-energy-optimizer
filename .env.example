# Application
APP_NAME=AI Classroom Energy Optimizer
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json
TIMEZONE=Asia/Kuala_Lumpur

# Browser access
CORS_ALLOWED_ORIGINS=http://localhost:5173
WS_HEARTBEAT_SECONDS=20
WS_CLIENT_TIMEOUT_SECONDS=60

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://aceo:change-me@localhost:5432/aceo
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Authentication (use a secret manager outside development)
AUTH_ENABLED=true
OIDC_ISSUER_URL=https://identity.example.edu
OIDC_AUDIENCE=aceo-api
OIDC_JWKS_URL=https://identity.example.edu/.well-known/jwks.json
JWT_ALGORITHM=RS256

# MQTT broker
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_CLIENT_ID=aceo-backend-dev
MQTT_USERNAME=aceo-backend
MQTT_PASSWORD=
MQTT_TOPIC_ROOT=aceo/v1
MQTT_TLS_ENABLED=true
MQTT_CA_CERT_PATH=/run/secrets/mqtt-ca.crt
MQTT_CLIENT_CERT_PATH=/run/secrets/mqtt-client.crt
MQTT_CLIENT_KEY_PATH=/run/secrets/mqtt-client.key
MQTT_KEEPALIVE_SECONDS=30
MQTT_COMMAND_ACK_TIMEOUT_SECONDS=10
MQTT_COMMAND_MAX_RETRIES=3

# Computer vision
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=person-detection
ROBOFLOW_MODEL_VERSION=1
CAMERA_SOURCE=
CV_TARGET_FPS=5
CV_CONFIDENCE_THRESHOLD=0.50
CV_OBSERVATION_STALE_SECONDS=10
CV_DIAGNOSTIC_FRAME_RETENTION_ENABLED=false

# Leave-within-60-seconds prediction
PREDICTION_MODEL_PATH=ml/artifacts/leave_within_60s.joblib
PREDICTION_MODEL_VERSION=untrained-v0
PREDICTION_FEATURE_SET_VERSION=v1
PREDICTION_INTERVAL_SECONDS=5
PREDICTION_TTL_SECONDS=15
PREDICTION_RECOMMENDATION_THRESHOLD=0.80

# Deterministic policy defaults
POLICY_VERSION=1.0.0
OCCUPIED_TARGET_TEMPERATURE_C=26.0
TEMPERATURE_DEADBAND_C=0.5
TARGET_ILLUMINANCE_LUX=300
ILLUMINANCE_HYSTERESIS_LUX=30
VACANCY_GRACE_SECONDS=300
LIGHTING_VACANCY_GRACE_SECONDS=120
ENVIRONMENT_READING_STALE_SECONDS=30
POWER_READING_STALE_SECONDS=30
COMMAND_COOLDOWN_SECONDS=10
AC_MIN_ON_SECONDS=180
AC_MIN_OFF_SECONDS=180
MANUAL_OVERRIDE_MAX_SECONDS=28800
SCHEDULE_MAX_LATENESS_SECONDS=60

# Energy analytics
ENERGY_CURRENCY=MYR
ENERGY_TARIFF_PER_KWH=0.00
ENERGY_BASELINE_METHOD=matched_occupied_periods_v1
ENERGY_AGGREGATION_INTERVAL_SECONDS=60

# Development only
SEED_DEMO_DATA=false

# React dashboard
NEXT_PUBLIC_USE_MOCK_DATA=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CLASSROOM_ID=26e97d46-7a34-4439-922a-83684bda557d
